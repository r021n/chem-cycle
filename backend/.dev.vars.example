# Environment lokal untuk `wrangler dev` (Workers runtime).
# Salin ke .dev.vars lalu isi nilainya:  cp .dev.vars.example .dev.vars
# File .dev.vars di-gitignore dan TIDAK ikut ter-deploy.

DATABASE_URL=libsql://REPLACE-WITH-YOUR-DB.turso.io
TURSO_AUTH_TOKEN=
JWT_SECRET=dev-only-ganti-dengan-random-string
CORS_ORIGIN=http://localhost:5173
BCRYPT_ROUNDS=6
ADMIN_DEFAULT_EMAIL=admin@ecoinclusive.edu
ADMIN_DEFAULT_PASSWORD=admin123
