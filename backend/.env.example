# Environment untuk backend (Node / shared hosting)
# Salin ke .env lalu isi nilainya:  cp .env.example .env

# --- Server (Node) ---
PORT=3001

# --- Keamanan ---
# WAJIB diganti di production (random string panjang).
JWT_SECRET=

# --- Database Turso (libsql over HTTP) ---
# Ambil dengan:
#   turso db show <nama-db> --url
#   turso db tokens create <nama-db>
# Dipakai oleh SEMUA runtime (Node, Workers, local dev). Mode file: tidak didukung lagi.
DATABASE_URL=libsql://REPLACE-WITH-YOUR-DB.turso.io
TURSO_AUTH_TOKEN=

# --- CORS ---
# Production: URL Cloudflare Pages (https://<project>.pages.dev)
# Local dev: http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# --- bcrypt cost factor ---
# PENTING: gunakan nilai yang SAMA di semua runtime (Node, Workers, dan saat seed).
# Hash lama menyimpan cost di dalamnya; verify cost-10 butuh ~100ms CPU sehingga
# login akan gagal di Workers Free (limit 10ms CPU). Pakai 6 untuk semua environment,
# atau 10 jika TIDAK deploy ke Workers Free.
BCRYPT_ROUNDS=6

# --- Seed admin (hanya dipakai npm run db:seed) ---
ADMIN_DEFAULT_EMAIL=admin@ecoinclusive.edu
ADMIN_DEFAULT_PASSWORD=admin123
